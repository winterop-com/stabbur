# A kodo project: which libraries it uses + its assistant. Portable (no machine
# paths). Copy to kodo.toml, or run `kodo project init`.

# Libraries to read, priority order. "@shared" = the machine default
# (KODO_LIBRARY_ROOT). Omit to use just the default.
libraries = ["models", "@shared"]

[project]
model = "gemma-4-12B-it-QAT-GGUF"   # a model in one of the libraries above
system_prompt = ""                  # prepended to every chat; "" = none

# MCP tool servers (repeatable). `command` required, `name` optional.
# [[mcp]]
# name = "dhis2"
# command = "dhis2w-mcp-bridge"

# Serve/runtime overrides also go here (host, port, serve_ui, ...).
