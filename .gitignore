# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
wheels/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# uv
# (uv.lock IS committed — it pins the environment)

# Test / coverage / type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environment / secrets
.env
.env.*
!.env.example

# Personal per-machine config (holds absolute library paths). The committed
# template is stabbur.toml.example; each checkout keeps its own stabbur.toml.
/stabbur.toml
/heim.toml  # a checkout that predates the rename

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Tooling scratch
.playwright-mcp/

# Frontend
node_modules/
frontend/dist/

# Docs build output
/site/

# Downloaded models — the library lives here and must never be committed.
# Override the location with STABBUR_LIBRARY_ROOT when moving to the 5TB drive.
/data/

# extension build + test artifacts
extension/.output/
extension/.wxt/
extension/test-results/
extension/playwright-report/
