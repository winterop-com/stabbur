# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
wheels/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# uv
# (uv.lock IS committed — it pins the environment)

# Test / coverage / type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environment / secrets
.env
.env.*
!.env.example

# Personal per-machine config (holds absolute library paths). The committed
# template is kodo.toml.example; each checkout keeps its own kodo.toml.
/kodo.toml

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Tooling scratch
.playwright-mcp/

# Frontend
frontend/node_modules/
frontend/dist/

# Docs build output
/site/

# Downloaded models — the library lives here and must never be committed.
# Override the location with LOCAL_LLM_BACKUP_ROOT when moving to the 5TB drive.
/data/
