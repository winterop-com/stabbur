{
  "name": "stabbur-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:dhis2": "STABBUR_FLAVOR=dhis2 wxt build",
    "build:e2e": "STABBUR_E2E=1 wxt build",
    "postinstall": "wxt prepare",
    "e2e": "bun run build && playwright test --project=mock",
    "screenshots": "bun run build && bun run build:dhis2 && bun run e2e/screenshots.ts",
    "e2e:live": "bun run build:e2e && STABBUR_E2E_BUILD=1 playwright test --project=live",
    "prompts": "bun run e2e/prompts/run.ts",
    "prompts:doc": "bun run e2e/prompts/regen-doc.ts",
    "prompts:parity": "bun run build && playwright test --project=prompts e2e/prompts/format-parity.spec.ts",
    "prompts:ui": "bun run build && playwright test --project=prompts e2e/prompts/ui.spec.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.22.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@playwright/test": "^1.50.0",
    "@wxt-dev/module-react": "^1.1.3",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "wxt": "^0.20.27"
  }
}
