# A stabbur project: which libraries it uses + its assistant. Portable (no machine
# paths). Copy to stabbur.toml, or run `stabbur project init`.

# Libraries to read, priority order. "@shared" = the machine default
# (STABBUR_LIBRARY_ROOT). Omit to use just the default.
libraries = ["models", "@shared"]

[project]
model = "publisher/some-model-GGUF"  # a model in one of the libraries above (`stabbur library ls`)
system_prompt = ""                   # prepended to every chat; "" = none

# Tools/MCP servers do NOT live here: they go in ./.mcp.json (the standard
# `mcpServers` JSON that Claude Desktop / Cursor use). Add one with
# `stabbur mcp add <name>` — see `stabbur mcp list` for the catalog.

# Serve/runtime overrides also go here (host, port, serve_ui, ...).
