# Copy to .env and adjust per machine (.env is gitignored).
# All vars are optional; sensible defaults apply if unset.

# Where the model library is stored. Defaults to ./data.
# This Mac: the 5TB exFAT drive. On Linux the mount path differs
# (e.g. /media/<user>/LLM or /mnt/llm).
LOCAL_LLM_BACKUP_ROOT=/Volumes/LLM/Library

# Optional Hugging Face token for gated/private repos (falls back to hf login).
# LOCAL_LLM_HF_TOKEN=hf_...

# Source store overrides (defaults shown).
# LOCAL_LLM_OLLAMA_MODELS_DIR=~/.ollama/models
# LOCAL_LLM_LMSTUDIO_MODELS_DIR=~/.lmstudio/models

# API bind address.
# LOCAL_LLM_HOST=127.0.0.1
# LOCAL_LLM_PORT=8000
